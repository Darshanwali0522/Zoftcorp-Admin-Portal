# =========================================================================
# ZOFTCORP ADMIN PORTAL — ENVIRONMENT CONFIGURATION
# Replace these values with your actual Supabase project credentials.
# You can find them in your Supabase Dashboard under:
# Project Settings -> API
# =========================================================================

# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous Public API Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role Key (Used ONLY in server-side administrative jobs, NEVER exposed client-side)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
